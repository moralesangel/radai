# Dependencies
node_modules/
functions/node_modules/

# Build output
dist/
functions/lib/

# Env / secrets
.env
.env.local
.env.*.local
functions/.env
functions/.env.*
!functions/.env.example
*.local

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
functions-debug.log
pglite-debug.log

# Each deploy points at its own project -- scripts/setup.sh (re)writes this
# locally. Tracked only as .firebaserc.example, a placeholder.
.firebaserc

# Optional per-deployer override (e.g. a custom Hosting site name via
# `-c firebase.personal.json`). Never shared -- everyone else deploys with
# the plain `firebase deploy`/firebase.json above.
firebase.personal.json

# Editor / OS
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
.claude/
