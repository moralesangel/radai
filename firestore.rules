rules_version = '2';

// All reads and writes go through Cloud Functions, which use the Admin SDK
// and bypass these rules -- the functions themselves enforce who's allowed
// to call them (see requireOwner in functions/src/index.ts). Clients are
// denied direct access so the Firestore data cannot be tampered with.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
