rules_version = '2';

// Single-user app with no auth: all reads and writes go through Cloud
// Functions, which use the Admin SDK and bypass these rules. Clients are
// denied direct access so the Firestore data cannot be tampered with.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
