# Firebase web config -- from Project settings > Your apps > Web app.
# Not secret; safe to expose in the client bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to call the local Functions emulator instead of deployed ones.
VITE_USE_EMULATOR=false
